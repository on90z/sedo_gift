# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_MAPS_API_KEY: Google Maps Platform browser API key.
VITE_GOOGLE_MAPS_API_KEY=""

# ADMIN_PASSCODE: Optional server-side override passcode for the admin dashboard.
ADMIN_PASSCODE=""

# SESSION_SECRET: Secret key used to sign admin and customer HMAC session tokens in production.
SESSION_SECRET=""

# MFA_ENCRYPTION_KEY: Optional AES-256-GCM key to encrypt stored TOTP 2FA secrets at rest.
MFA_ENCRYPTION_KEY=""

# TELEGRAM_BOT_TOKEN & TELEGRAM_CHAT_ID: Optional Telegram new-order notification integration.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Netlify Frontend + Persistent Backend Split-Origin Deployment (optional; blank for same-origin hosting):
# VITE_API_BASE_URL: Full HTTPS origin of the persistent Express backend (e.g. "https://api.your-domain.com")
VITE_API_BASE_URL=""
# VITE_PUBLIC_SITE_URL: Public storefront URL displayed in QR codes & admin links (e.g. "https://your-site.netlify.app")
VITE_PUBLIC_SITE_URL=""
# CORS_ALLOWED_ORIGINS: Comma-separated allowed frontend origins on the Express backend (e.g. "https://your-site.netlify.app,https://admin.your-domain.com")
CORS_ALLOWED_ORIGINS=""

