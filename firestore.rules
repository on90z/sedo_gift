rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isBootstrapAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'moimlali00@gmail.com';
    }

    function isAdmin() {
      return isBootstrapAdmin() || (isVerifiedUser() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isValidProduct(data) {
      return data.keys().hasAll(['id', 'kind', 'category', 'nameAr', 'nameEn', 'priceIqd', 'stock', 'isAvailable', 'imageUrl']) &&
        data.keys().hasOnly(['id', 'kind', 'category', 'categoryAr', 'nameAr', 'nameEn', 'descriptionAr', 'descriptionEn', 'priceIqd', 'promoPriceIqd', 'roseCount', 'stock', 'isAvailable', 'isFeatured', 'isBestSeller', 'imageUrl', 'updatedAt']) &&
        isValidId(data.id) &&
        data.kind in ['bouquet', 'gift', 'category_featured'] &&
        data.category is string && data.category.size() <= 64 &&
        (!('categoryAr' in data) || (data.categoryAr is string && data.categoryAr.size() <= 64)) &&
        data.nameAr is string && data.nameAr.size() > 0 && data.nameAr.size() <= 140 &&
        data.nameEn is string && data.nameEn.size() > 0 && data.nameEn.size() <= 140 &&
        data.priceIqd is number && data.priceIqd >= 0 &&
        (!('promoPriceIqd' in data) || data.promoPriceIqd == null || (data.promoPriceIqd is number && data.promoPriceIqd >= 0)) &&
        data.stock is number && data.stock >= 0 &&
        data.isAvailable is bool &&
        data.imageUrl is string && data.imageUrl.size() <= 500;
    }

    function isValidOption(data) {
      return data.keys().hasAll(['id', 'group', 'nameAr', 'nameEn', 'priceIqd', 'isAvailable', 'imageUrl']) &&
        data.keys().hasOnly(['id', 'group', 'nameAr', 'nameEn', 'priceIqd', 'colorHex', 'stock', 'isAvailable', 'imageUrl']) &&
        isValidId(data.id) &&
        data.group in ['flower_type', 'flower_color', 'wrapping', 'arrangement', 'gift'] &&
        data.nameAr is string && data.nameAr.size() > 0 && data.nameAr.size() <= 120 &&
        data.nameEn is string && data.nameEn.size() > 0 && data.nameEn.size() <= 120 &&
        data.priceIqd is number && data.priceIqd >= 0 &&
        data.isAvailable is bool &&
        data.imageUrl is string && data.imageUrl.size() <= 500;
    }

    function isValidCustomer(data) {
      return data.keys().hasAll(['id', 'userId', 'fullName', 'phone', 'birthDate', 'marketingConsent', 'locationConsent']) &&
        data.keys().hasOnly(['id', 'userId', 'fullName', 'phone', 'birthDate', 'marketingConsent', 'locationConsent', 'totalOrders', 'totalSpentIqd', 'createdAt']) &&
        isValidId(data.id) &&
        data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
        data.fullName is string && data.fullName.size() > 0 && data.fullName.size() <= 120 &&
        data.phone is string && data.phone.size() >= 8 && data.phone.size() <= 32 &&
        data.birthDate is string && data.birthDate.size() <= 16 &&
        data.marketingConsent is bool &&
        data.locationConsent is bool;
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['id', 'orderNumber', 'userId', 'customerId', 'customerName', 'customerPhone', 'status', 'totalIqd', 'createdAt']) &&
        data.keys().hasOnly(['id', 'orderNumber', 'userId', 'customerId', 'customerName', 'customerPhone', 'customerBirthDate', 'status', 'totalIqd', 'discountIqd', 'paymentMethod', 'deliveryType', 'notes', 'itemsSummary', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        data.orderNumber is string && data.orderNumber.size() > 0 && data.orderNumber.size() <= 40 &&
        data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
        data.customerId is string && data.customerId.size() > 0 && data.customerId.size() <= 128 &&
        data.customerName is string && data.customerName.size() > 0 && data.customerName.size() <= 120 &&
        data.customerPhone is string && data.customerPhone.size() >= 8 && data.customerPhone.size() <= 32 &&
        data.status in ['New', 'Confirmed', 'Preparing', 'Ready', 'Completed', 'Cancelled'] &&
        data.totalIqd is number && data.totalIqd >= 0;
    }

    function isValidLoyaltyCard(data) {
      return data.keys().hasAll(['id', 'customerId', 'userId', 'customerName', 'stampsCount', 'rewardStatus']) &&
        data.keys().hasOnly(['id', 'customerId', 'userId', 'customerName', 'stampsCount', 'rewardStatus', 'completedCardsCount', 'updatedAt']) &&
        isValidId(data.id) &&
        data.stampsCount is number && data.stampsCount >= 0 && data.stampsCount <= 10 &&
        data.rewardStatus in ['in_progress', 'unlocked', 'redeemed'] &&
        data.customerName is string && data.customerName.size() <= 120;
    }

    function isValidStoreSettings(data) {
      return data.keys().hasAll(['id', 'roseUnitPriceIqd', 'storeNameAr', 'storeNameEn']) &&
        data.keys().hasOnly([
          'id', 'roseUnitPriceIqd', 'maxCustomRoses',
          'storeNameAr', 'storeNameEn', 'taglineAr', 'taglineEn',
          'logoUrl', 'heroBannerUrl', 'storePhotoUrl',
          'heroHeadlineAr', 'heroHeadlineEn', 'heroSubtitleAr', 'heroSubtitleEn',
          'heroPrimaryCtaAr', 'heroPrimaryCtaEn', 'heroSecondaryCtaAr', 'heroSecondaryCtaEn',
          'categoriesSectionTitleAr', 'categoriesSectionTitleEn',
          'featuredSectionTitleAr', 'featuredSectionTitleEn',
          'loyaltyPromoBadgeAr', 'loyaltyPromoBadgeEn',
          'loyaltyPromoTitleAr', 'loyaltyPromoTitleEn',
          'loyaltyPromoDescAr', 'loyaltyPromoDescEn',
          'aboutTitleAr', 'aboutTitleEn', 'aboutTextAr', 'aboutTextEn',
          'footerTextAr', 'footerTextEn',
          'builderTitleAr', 'builderTitleEn', 'builderSubtitleAr', 'builderSubtitleEn',
          'offerBannerEnabled', 'offerBannerTextAr', 'offerBannerTextEn',
          'categories', 'addressAr', 'addressEn',
          'phone', 'secondaryPhone', 'instagramHandle', 'instagramUrl',
          'workingHoursAr', 'workingHoursEn',
          'latitude', 'longitude', 'googleMapsUrl', 'googleBusinessProfileUrl', 'locationVerified',
          'proximityEnabled', 'proximityRadiusMeters', 'proximityCooldownHours',
          'proximityMessageAr', 'proximityMessageEn',
          'loyaltyReward', 'paymentMethods', 'telegramNotifyOnOrder',
          'defaultLanguage', 'updatedAt'
        ]) &&
        data.id is string && data.id.size() <= 64 &&
        data.roseUnitPriceIqd is number && data.roseUnitPriceIqd >= 0 &&
        data.storeNameAr is string && data.storeNameAr.size() <= 120 &&
        data.storeNameEn is string && data.storeNameEn.size() <= 120 &&
        (!('proximityRadiusMeters' in data) || (data.proximityRadiusMeters is number && data.proximityRadiusMeters >= 50)) &&
        (!('categories' in data) || (data.categories is list && data.categories.size() <= 30)) &&
        (!('paymentMethods' in data) || (data.paymentMethods is list && data.paymentMethods.size() <= 20));
    }

    // Public catalog: products and bouquet builder options
    match /products/{productId} {
      allow get: if isValidId(productId);
      allow list: if true;
      allow create, update: if isAdmin() && isValidId(productId) && isValidProduct(incoming());
      allow delete: if isAdmin() && isValidId(productId);
    }

    match /options/{optionId} {
      allow get: if isValidId(optionId);
      allow list: if true;
      allow create, update: if isAdmin() && isValidId(optionId) && isValidOption(incoming());
      allow delete: if isAdmin() && isValidId(optionId);
    }

    match /store_settings/{settingId} {
      allow get: if isValidId(settingId) && (settingId == 'public' || isAdmin());
      allow list: if isBootstrapAdmin();
      allow create, update: if isAdmin() && isValidId(settingId) && isValidStoreSettings(incoming());
      allow delete: if isAdmin() && isValidId(settingId);
    }

    // Customers: strict PII isolation
    match /customers/{customerId} {
      allow get: if isValidId(customerId) && (isAdmin() || (isVerifiedUser() && existing().userId == request.auth.uid));
      allow list: if isBootstrapAdmin() || (isVerifiedUser() && resource.data.userId == request.auth.uid);
      allow create: if isVerifiedUser() && isValidId(customerId) && isValidCustomer(incoming()) &&
        incoming().userId == request.auth.uid && incoming().createdAt == request.time;
      allow update: if isValidId(customerId) && isValidCustomer(incoming()) && (
        isAdmin() ||
        (isVerifiedUser() && existing().userId == request.auth.uid && incoming().userId == existing().userId &&
         incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'phone', 'birthDate', 'marketingConsent', 'locationConsent']))
      );
      allow delete: if isAdmin() && isValidId(customerId);
    }

    // Orders: owner or admin read, validated create, admin status management
    match /orders/{orderId} {
      allow get: if isValidId(orderId) && (isAdmin() || (isVerifiedUser() && existing().userId == request.auth.uid));
      allow list: if isBootstrapAdmin() || (isVerifiedUser() && resource.data.userId == request.auth.uid);
      allow create: if isVerifiedUser() && isValidId(orderId) && isValidOrder(incoming()) &&
        incoming().userId == request.auth.uid &&
        incoming().status == 'New' &&
        incoming().createdAt == request.time;
      allow update: if isAdmin() && isValidId(orderId) && isValidOrder(incoming()) &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt;
      allow delete: if isAdmin() && isValidId(orderId);
    }

    // Loyalty cards: owner can read only; ONLY admin can create/update/approve stamps
    match /loyalty_cards/{cardId} {
      allow get: if isValidId(cardId) && (isAdmin() || (isVerifiedUser() && existing().userId == request.auth.uid));
      allow list: if isBootstrapAdmin() || (isVerifiedUser() && resource.data.userId == request.auth.uid);
      allow create, update: if isAdmin() && isValidId(cardId) && isValidLoyaltyCard(incoming());
      allow delete: if isAdmin() && isValidId(cardId);
    }

    // Loyalty transactions: owner can read only; ONLY admin can write audit records
    match /loyalty_transactions/{txId} {
      allow get: if isValidId(txId) && (isAdmin() || (isVerifiedUser() && existing().userId == request.auth.uid));
      allow list: if isBootstrapAdmin() || (isVerifiedUser() && resource.data.userId == request.auth.uid);
      allow create, update, delete: if isAdmin() && isValidId(txId);
    }

    // Admin-only collections
    match /notifications/{notifId} {
      allow get: if isAdmin() && isValidId(notifId);
      allow list: if isBootstrapAdmin();
      allow create, update, delete: if isAdmin() && isValidId(notifId);
    }

    match /birthday_campaigns/{campaignId} {
      allow get: if isAdmin() && isValidId(campaignId);
      allow list: if isBootstrapAdmin();
      allow create, update, delete: if isAdmin() && isValidId(campaignId);
    }

    match /audit_logs/{logId} {
      allow get: if isAdmin() && isValidId(logId);
      allow list: if isBootstrapAdmin();
      allow create, update, delete: if isAdmin() && isValidId(logId);
    }

    match /admins/{uid} {
      allow get: if isAdmin() && isValidId(uid);
      allow list: if isBootstrapAdmin();
      allow create, update, delete: if isBootstrapAdmin() && isValidId(uid);
    }

    // Connectivity probe path for testConnection()
    match /test/connection {
      allow get: if true;
    }
  }
}
